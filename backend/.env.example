# Application Environment: 'development', 'testing', or 'production'
# In production, SECRET_KEY must be a cryptographically secure random string (min 32 characters)
# and cannot be a default or placeholder value.
ENVIRONMENT=development

# Database
# Development SQLite: sqlite:///./app.db
# Production PostgreSQL: postgresql://postgres:postgres@localhost:5432/crop_health_db
DATABASE_URL=sqlite:///./app.db

# JWT Authentication
# Generate a secure key (min 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Do not share or commit this key. Changing it invalidates all existing active tokens.
SECRET_KEY=your-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (per-minute limits to protect auth and inference endpoints)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_DETECTION_LIMIT=10
RATE_LIMIT_DETECTION_WINDOW=60

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your-openweathermap-api-key

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Default Farm Settings
DEFAULT_FARM_NAME=My Ahmedabad Farm
DEFAULT_FARM_LOCATION=Ahmedabad, Gujarat, India

# Sample image library (development/demo aid). Set ENABLE_SAMPLE_LIBRARY=false in production.
SAMPLE_LIBRARY_DIR=uploads/sample_images
ENABLE_SAMPLE_LIBRARY=true

# CORS
FRONTEND_URL=http://localhost:5173

# ML Model Paths (optional - app works in simulated fallback mode without these)
YOLO_MODEL_PATH=ml/models/yolov8_crop_disease.pt
TENSORFLOW_MODEL_PATH=ml/models/crop_disease_model.h5
